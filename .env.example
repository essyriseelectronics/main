# CLOUDFLARE D1 DATABASE SECRETS
# Do not commit the actual .env file. Add these variables in your Vercel Dashboard.

CLOUDFLARE_ACCOUNT_ID="your_cloudflare_account_id"
CLOUDFLARE_D1_ID="your_d1_database_id"
CLOUDFLARE_API_TOKEN="your_cloudflare_api_token"

# CLOUDFLARE R2 STORAGE (For Product Images)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key"
R2_SECRET_ACCESS_KEY="your_r2_secret_key"
R2_BUCKET_NAME="essyrise-images"
NEXT_PUBLIC_R2_PUBLIC_URL="https://pub-your-r2-dev-url.r2.dev"
